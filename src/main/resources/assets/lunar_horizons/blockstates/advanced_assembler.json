{
  "multipart": [
    {
      "when": {
        "facing": "north",
        "lit": "false"
      },
      "apply": {
        "model": "lunar_horizons:block/advanced_assembler"
      }
    },
    {
      "when": {
        "facing": "east",
        "lit": "false"
      },
      "apply": {
        "model": "lunar_horizons:block/advanced_assembler",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "lit": "false"
      },
      "apply": {
        "model": "lunar_horizons:block/advanced_assembler",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "lit": "false"
      },
      "apply": {
        "model": "lunar_horizons:block/advanced_assembler",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "lit": "true"
      },
      "apply": {
        "model": "lunar_horizons:block/advanced_assembler_on"
      }
    },
    {
      "when": {
        "facing": "east",
        "lit": "true"
      },
      "apply": {
        "model": "lunar_horizons:block/advanced_assembler_on",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "lit": "true"
      },
      "apply": {
        "model": "lunar_horizons:block/advanced_assembler_on",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "lit": "true"
      },
      "apply": {
        "model": "lunar_horizons:block/advanced_assembler_on",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "lunar_horizons:block/machine_top_socket"
      }
    }
  ]
}

{
  "multipart": [
    {
      "when": {
        "facing": "north",
        "lit": "false"
      },
      "apply": {
        "model": "lunar_horizons:block/electric_refill"
      }
    },
    {
      "when": {
        "facing": "east",
        "lit": "false"
      },
      "apply": {
        "model": "lunar_horizons:block/electric_refill",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "lit": "false"
      },
      "apply": {
        "model": "lunar_horizons:block/electric_refill",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "lit": "false"
      },
      "apply": {
        "model": "lunar_horizons:block/electric_refill",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "lit": "true"
      },
      "apply": {
        "model": "lunar_horizons:block/electric_refill_on"
      }
    },
    {
      "when": {
        "facing": "east",
        "lit": "true"
      },
      "apply": {
        "model": "lunar_horizons:block/electric_refill_on",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "lit": "true"
      },
      "apply": {
        "model": "lunar_horizons:block/electric_refill_on",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "lit": "true"
      },
      "apply": {
        "model": "lunar_horizons:block/electric_refill_on",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "lunar_horizons:block/machine_top_socket"
      }
    }
  ]
}
